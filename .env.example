# Stripe (test mode)
VITE_STRIPE_PRICE_PRO_MONTHLY=price_1Khxxxxxxx_pro_monthly
VITE_STRIPE_PRICE_BUSINESS_MONTHLY=price_1Khxxxxxxx_business_monthly

# Backend (server) env (example) — set these on your server only
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ztoolkit

# Optional: backend API base (leave empty to use same origin)
# VITE_API_BASE=https://api.myapp.example

# Local dev tip:
# To run Postgres locally with docker-compose (recommended):
# 1) docker compose up -d postgres
# 2) set DATABASE_URL in your shell or .env to postgres://postgres:postgres@localhost:5432/ztoolkit
# 3) cd backend && pnpm prisma:migrate
# 4) cd .. && pnpm dev (frontend)

# Notes:
# - Put real Stripe Price IDs (from Dashboard) in production only on the deploy environment.
# - Never commit secret API keys (use server env vars).